/* SPDX-License-Identifier: LGPL-2.1-or-later
 *
 * td.cuh's device half, as MSL: trial division, resieving, survivor ranking,
 * and CADO's check_leftover_norm classification.
 *
 * Body is td_body.metal.inc, generated by metal/gen_td_metal.py and then
 * hand-fixed; the generator is a porting aid, not part of the build.
 *
 * Forking td.cuh here is what lets bench_kernels.metal and cofac_metal.cpp
 * drop their copies of td_mod_magic, SS_KSHIFT, TD_SCAN_BLK and TD_FMAX.
 * td.cuh calls SS_KSHIFT "the single source of truth for the bias shift", and
 * a duplicated single source of truth is a contradiction that rots.
 *
 * k_classify is where Phase 2 pays off a second time: it calls cof_classify,
 * whose CADO gap test is written against doubles that this GPU does not have.
 * prp_msl.h routes it through softfp64.
 */
#include "cuda_msl_compat.h"
#include "softfp64.h"
#include "sf_sites.h"
#include "bigint_msl.h"
#include "prp_msl.h"
#include "plattice_msl.h"
#include "slab_msl.h"
#include "td_msl.h"

/* bench.h's degree bound, which tdpoly_t's coefficient array is sized by. */
#define BENCH_MAX_DEGREE 8
#define BENCH_NCOEFF (BENCH_MAX_DEGREE + 1)

/* MSL has no <stddef.h>; the ported code uses NULL as a null pointer only. */
#ifndef NULL
#define NULL nullptr
#endif

/* td.cuh's shared section -- types, TD_* bounds, td_mod_magic, SS_KSHIFT --
 * comes from td_msl.h, generated from td.cuh itself. Stated once per build. */

#include "td_body.metal.inc"
