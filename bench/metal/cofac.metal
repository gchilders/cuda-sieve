/* SPDX-License-Identifier: LGPL-2.1-or-later
 *
 * cofac.cuh's device half, as MSL: Montgomery arithmetic on 3 or 4 limbs,
 * Pollard-Brent rho, ECM with an optional stage 2, and the kernels the
 * standalone cofactoriser (run_cofac) drives.
 *
 * Body is cofac_body.metal.inc, generated by metal/gen_cofac_metal.py and
 * then hand-fixed; the generator is a porting aid, not part of the build.
 *
 * SCOPE. This covers what run_cofac reaches: k_cofac (six instantiations,
 * 3 and 4 limbs x rho / ECM / ECM-with-stage-2), the two compaction kernels,
 * and the three-pass scan cf_run_rounds borrows from td.cuh. The INLINE-QUEUE
 * kernels the sieve pipeline uses -- k_cof_enqueue with its cofq_t argument
 * buffer, k_cof_gate, k_rel_* -- are not here yet; the argument-buffer
 * mechanism they need is already proven by metal/argbuf_test.cpp.
 */
#include "cuda_msl_compat.h"
#include "softfp64.h"

/* Status codes and sizes from cofac.cuh, which the extracted device body
 * references but which live above the extracted range. Values must track
 * cofac.cuh:90-95 and :410 exactly -- the host compares against them. */
#define CF_OK         0
#define CF_DEAD       1
#define CF_INCOMPLETE 2
#define CF_OVERFLOW   3
#define CF_MAXFAC     4
#define CF_BATCH    128
#define CF_ECM_D      30u
#define CF_ECM_NBABY   4u
#define TD_SCAN_BLK  256

/* bigint.cuh's bn_t, for the kernels that narrow a norm residual. */
#ifndef BN_LIMBS
#define BN_LIMBS 12
#endif
typedef struct { uint32_t v[BN_LIMBS]; } bn_t;

#include "cofac_body.metal.inc"
