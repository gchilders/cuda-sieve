+/* x_prac's rules on integer multiples: A, B, C, T, T2 stand for [a]P etc. */
+static int cf_prac_add(uint64_t *out, uint64_t x, uint64_t y, uint64_t dif)
+{
+    if (x == y || !dif || dif != (x > y ? x - y : y - x)) return 0;
+    *out = x + y;
+    return 1;
+}
+static int cf_prac_valid(uint32_t k, uint32_t r)
+{
