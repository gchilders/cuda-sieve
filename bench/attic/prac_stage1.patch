+        if (d - e <= e / 4 && (d + e) % 3 == 0) { d = (2 * d - e) / 3; e = (e - d) / 2; c += 18; }
+        else if (d - e <= e / 4 && (d - e) % 6 == 0) { d = (d - e) / 2; c += 12; }
+        else if ((d + 3) / 4 <= e) { d -= e; c += 6; }
+        else if ((d + e) % 2 == 0) { d = (d - e) / 2; c += 12; }
+        else if (d % 2 == 0) { d /= 2; c += 12; }
+        else if (d % 3 == 0) { d = d / 3 - e; c += 24; }
