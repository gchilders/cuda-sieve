+/* Multiplies to reach [k]P from r = round(k*v), as x_prac would spend them. */
+static uint32_t cf_lucas_cost(uint32_t k, double v)
+{
+    uint32_t d, e, c, r = (uint32_t)((double)k * v + 0.5);
+    if (r >= k || 2 * r < k) return 0xffffffffu;
+    d = k - r; e = 2 * r - k; c = 12;          /* first x_dbl, last x_add */
