+            C = x; A *= 2;
+        } else if (d % 3 == 0) {
+            d = d / 3 - e;
+            T = 2 * A;
+            if (!cf_prac_add(&T2, A, B, C) || !cf_prac_add(&x, T, A, A)) return 0;
+            A = x;
+            if (!cf_prac_add(&x, T, T2, C)) return 0;
+            C = B; B = x;
+        } else if ((d + e) % 3 == 0) {
+            d = (d - 2 * e) / 3;
+            if (!cf_prac_add(&T, A, B, C) || !cf_prac_add(&x, T, A, B)) return 0;
+            B = x; T = 2 * A;
+            if (!cf_prac_add(&x, A, T, A)) return 0;
+            A = x;
+        } else if ((d - e) % 3 == 0) {
+            d = (d - e) / 3;
